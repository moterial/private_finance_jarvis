# Environment Variables
# Copy this file to .env.local and fill in your API keys

# ============ AI Model (OpenAI-compatible) ============
# Only key required! Everything else works for free.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ============ Optional Overrides ============
# All data sources below work WITHOUT keys (Reddit public JSON, Yahoo Finance, RSS feeds).
# Only set these if you want to use the official APIs instead.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# FINNHUB_API_KEY=
# NEWS_API_KEY=

# ============ Supabase (Required for auth & data persistence) ============
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
